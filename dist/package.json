{
  "name": "asr-studio-ultrax",
  "version": "9.0.0",
  "description": "ASR Studio UltraX v9.0.0 (NodeJS) — Jianying-first extreme cloud ASR → live atomic SRT. Zero-dependency, zero-ffmpeg passthrough audio (MP4/fMP4/MOV/M4A/MP3/AAC/WAV), Viterbi DP Subtitle Engine, Myers Bit-Parallel Merger, NO-FALLBACK.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
