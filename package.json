{
  "name": "asr-studio-ultrax",
  "version": "9.0.0",
  "description": "ASR Studio UltraX v9.0.0 (NodeJS) — Jianying-first extreme cloud ASR → live atomic SRT. Zero-dependency, zero-ffmpeg passthrough audio (MP4/fMP4/MOV/M4A/MP3/AAC/WAV), Viterbi DP Subtitle Engine, Myers Bit-Parallel Merger, NO-FALLBACK.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cli": "./src/cli.js",
    "./gui": "./src/gui.js",
    "./probe": "./src/model-probe.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "asr-ultrax": "bin/asr-ultrax.js"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.mjs\"",
    "build": "node scripts/build-dist.mjs",
    "build:fast": "node scripts/build-dist.mjs --no-verify",
    "verify:dist": "node scripts/verify-dist.mjs",
    "start": "node dist/gui.js",
    "cli": "node bin/asr-ultrax.js",
    "gui": "node src/gui.js",
    "gui:dist": "node dist/gui.js",
    "cli:dist": "node dist/bin/asr-ultrax.js",
    "probe": "node src/model-probe.js"
  },
  "keywords": [
    "asr",
    "subtitle",
    "srt",
    "vtt",
    "lrc",
    "jianying",
    "capcut",
    "tts",
    "ultrax"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
