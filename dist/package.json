    "bin/",
    "*.js",
    "*.mjs",
    "*.map",
    "BUILD.json",
    "README.md",
    "run.bat",
    "run.sh"
  ],
  "scripts": {
    "start": "node gui.js",
    "cli": "node bin/asr-ultrax.js",
    "probe": "node model-probe.js"
  },
  "keywords": [
    "asr",
    "subtitle",
    "srt",
    "vtt",
    "lrc",
    "jianying",
    "capcut",
    "tts",
    "ultrax"
  ],
  "license": "MIT",
